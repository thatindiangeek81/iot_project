# Copy this file to ".env" and fill in the first three values.

# --- Required -------------------------------------------------------
# Your Gemini key (the same one the Cloudflare Worker uses)
GEMINI_API_KEY=paste-your-gemini-key-here
# Same value as DEVICE_TOKEN in the firmware's secrets.h
DEVICE_TOKEN=paste-the-same-token-as-in-secrets.h
# PostgreSQL in Docker (the db/ folder): user friday, the password from db/.env, database friday.
# Tables are created automatically the first time server.py starts.
DATABASE_URL=postgresql://friday:YOUR_DB_PASSWORD@localhost:5432/friday

# --- Gemini -----------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash-lite
# How long Gemini thinks before answering: low (fastest) | medium | high | blank = Google's default
GEMINI_REASONING=low
# Web search: Google Search grounding (needs billing on the Gemini key for 3.x models),
# and DuckDuckGo (free) when Google refuses. auto | google | duckduckgo
WEB_SEARCH=1
SEARCH_PROVIDER=auto
SEARCH_REGION=in-en
MAX_REPLY_CHARS=400

# --- Speed ------------------------------------------------------------
# No first word from Gemini after this many seconds: ask again on a fresh connection, use the faster one
GEMINI_HEDGE_S=3
# Ping Google when the line has been quiet this long, so the connection never goes stale (0 = off)
GEMINI_KEEPALIVE_S=40
# Reuse a weather lookup this many seconds (0 = always ask) and keep your home city's fresh in the background
WEATHER_CACHE_S=600
WEATHER_PREFETCH=1
# Seconds to wait for Open-Meteo before giving up on a weather lookup
WEATHER_TIMEOUT=4
# Run Whisper once at start-up so the first question isn't the slow one
STT_WARMUP=1
# Start speaking while Gemini is still writing (0 = write the whole reply first, as before)
STREAM_REPLIES=1
# ...but don't start before Gemini has finished the round that writes the reply, unless it takes longer than this
STREAM_HOLD_MS=1500
# Say "One sec, boss." while a slow tool (web search, weather that isn't cached) runs
TOOL_FILLER=1
# Streaming switches itself off after this many broken turns in a row (they are answered the normal way)
STREAM_MAX_FAILS=3

# --- Memory -----------------------------------------------------------
# Learn facts automatically after each reply (1) or only when asked (0)
AUTO_MEMORY=1
# Up to this many memories, all go in the prompt and no search runs (faster)
MEMORY_ALL_FACTS_MAX=40
# Recent exchanges kept word for word, and the silence (minutes) that starts a new conversation
HISTORY_TURNS=8
SESSION_GAP_MIN=10
TIMEZONE=Asia/Kolkata

# --- Speech recognition -------------------------------------------------
# tiny | base | small. "small" hears a noisy mic better but is ~3x slower on CPU.
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
# cpu + int8 always works. cuda + int8_float16 uses the GPU (needs CUDA 12 cuBLAS + cuDNN 9);
# if CUDA fails it falls back to the CPU automatically.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# --- Voice ----------------------------------------------------------------
# edge  = Microsoft neural voice (online, free Edge read-aloud service), local voice as backup
# local = Piper / Windows voice only, fully offline
TTS_ENGINE=edge
# Irish female. Others: en-GB-SoniaNeural (British), en-IN-NeerjaNeural (Indian), en-US-AriaNeural
EDGE_VOICE=en-IE-EmilyNeural
EDGE_RATE=+10%
EDGE_PITCH=+0Hz
# Short replies kept as audio so they play instantly (0 = off)
TTS_CACHE_MAX=500
# How many sentences of one reply the Edge voice makes at the same time (1 = one after the other)
TTS_PARALLEL=3

# Local voice (backup, or the only one with TTS_ENGINE=local):
# leave both blank for the Windows voice. For Piper, set both paths.
PIPER_EXE=
PIPER_MODEL=
# Windows voice used when Piper isn't set. "Zira" = female (US). Run "python tts.py" to list yours.
SAPI_VOICE=Zira
SAPI_RATE=175

# --- Music ----------------------------------------------------------------
# Folder with your songs. Index it with:  python music.py scan
MUSIC_DIR=D:\songs
ITUNES_COUNTRY=IN
# Look for new songs every N minutes (0 = only when you ask Friday)
MUSIC_SCAN_MIN=30
# Keep playing other songs after the one you asked for
MUSIC_AUTOPLAY=1
# Even out loud and quiet songs
MUSIC_LOUDNORM=1
# Answer "pause", "next", "play X" without a second Gemini call (about 1 s faster)
FAST_MUSIC_REPLIES=1
# ffmpeg converts songs for the speaker (winget install Gyan.FFmpeg). Full path if it isn't on PATH:
FFMPEG=ffmpeg

# --- Network --------------------------------------------------------------
HTTP_PORT=8765
UDP_PORT=5006

# --- Debug ----------------------------------------------------------------
# Writes last_question.wav and last_reply.wav next to the script
SAVE_AUDIO=1
# One line per question in latency.log: where the time went
LATENCY_LOG=1
